{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "chmod +x mvnw && ./mvnw clean package -DskipTests --no-transfer-progress"
  },
  "deploy": {
    "startCommand": "java -Dserver.port=$PORT -jar target/admin-0.0.1-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/categories",
    "healthcheckTimeout": 120
  }
}
