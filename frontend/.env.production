# ============================================================
# PRODUCTION ENVIRONMENT — Frontend (Vercel)
# ============================================================
#
# HOW TO USE:
# 1. Deploy the Spring Boot backend to Railway first.
# 2. In Railway → your backend service → Settings → Networking → Generate Domain
# 3. Copy the Railway domain (e.g. https://avirapyrotech-backend.up.railway.app)
# 4. Replace the URL below with your actual Railway URL + /api
# 5. ALSO add this variable in Vercel Dashboard:
#    Vercel → Project → Settings → Environment Variables
#    Key:   VITE_API_URL
#    Value: https://YOUR-RAILWAY-BACKEND.up.railway.app/api
#
# WARNING: Never put JWT_SECRET, DB passwords, or any backend secrets here.
# VITE_ variables are embedded into the public JavaScript bundle.
# ============================================================

VITE_API_URL=https://YOUR-RAILWAY-BACKEND.up.railway.app/api
